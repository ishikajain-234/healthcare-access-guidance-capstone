# Backend API Configuration
PORT=5001
NODE_ENV=development

# Admin Authorization Boundary (Phase 2)
# Set to 'true' SOLELY for local academic demonstration.
# MUST NEVER be enabled in staging, production, or multi-user environments.
ALLOW_UNAUTHENTICATED_ADMIN_DEMO=true

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_guidance_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_guidance_db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
