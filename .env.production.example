# ==============================================================================
# Production Environment Configuration Template
# Healthcare Access Guidance & Operations Platform
#
# INSTRUCTIONS:
# Copy this file to .env.production and provide real infrastructure secrets.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Security Boundaries (STRICTLY DISABLED IN PRODUCTION)
# In production, bypasses are rejected by middleware even if set to true.
ALLOW_UNAUTHENTICATED_ADMIN_DEMO=false
ALLOW_UNAUTHENTICATED_STAFF_DEMO=false

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (PostgreSQL 14+)
DB_HOST=your-production-db-host.internal
DB_PORT=5432
DB_NAME=healthcare_guidance_db
DB_USER=healthcare_app_user
DB_PASSWORD=replace_with_strong_generated_password
DATABASE_URL=postgresql://healthcare_app_user:replace_with_strong_generated_password@your-production-db-host.internal:5432/healthcare_guidance_db

# Connection Pool Settings
DB_POOL_MAX=25
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000
DB_SSL=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=https://guidance.health.delhi.gov.in,https://operations.health.delhi.gov.in

# Frontend Public API URL (Injected at build time into Vite)
VITE_API_BASE_URL=/api
